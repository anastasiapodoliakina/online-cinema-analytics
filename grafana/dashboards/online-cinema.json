      "id": 1,
      "title": "Retention Cohort Heatmap",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT metric_date AS Cohort, maxIf(value, metric_name = 'retention_d0') AS \"Day 0\", maxIf(value, metric_name = 'retention_d1') AS \"Day 1\", maxIf(value, metric_name = 'retention_d2') AS \"Day 2\", maxIf(value, metric_name = 'retention_d3') AS \"Day 3\", maxIf(value, metric_name = 'retention_d4') AS \"Day 4\", maxIf(value, metric_name = 'retention_d5') AS \"Day 5\", maxIf(value, metric_name = 'retention_d6') AS \"Day 6\", maxIf(value, metric_name = 'retention_d7') AS \"Day 7\" FROM daily_metrics FINAL WHERE startsWith(metric_name, 'retention_d') AND dimension = '' GROUP BY metric_date HAVING maxIf(value, metric_name = 'retention_d0') IS NOT NULL ORDER BY metric_date DESC",
          "pluginVersion": "4.8.2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
